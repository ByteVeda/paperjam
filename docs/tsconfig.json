{
  // This file is not used in compilation. It is here just for a nice editor experience.
  //
  // `@docusaurus/tsconfig` still sets `baseUrl`, which TypeScript 7 removed,
  // and its `paths` would resolve relative to the package rather than to this
  // site. Inline the same options here instead, with `@site/*` pointing at
  // this directory.
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "module": "esnext",
    "noEmit": true,
    "paths": {
      "@site/*": ["./*"]
    },
    "skipLibCheck": true
  },
  "exclude": [".docusaurus", "build"]
}
